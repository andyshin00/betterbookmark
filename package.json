{
  "name": "betterbookmark",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @betterbookmark/db db:generate",
    "db:migrate": "pnpm --filter @betterbookmark/db db:migrate",
    "db:studio": "pnpm --filter @betterbookmark/db db:studio",
    "auth:generate": "pnpm --filter web exec auth generate --config lib/auth.ts --output ../../packages/db/src/auth-schema.ts --yes"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "private": true,
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10"
  }
}
